+/*********************************************************************
+ *           PsGetProcessExitStatus    (NTOSKRNL.@)
+ *
+ * STATUS_PENDING while the process is still running, its exit code once
+ * it is gone. Asked for fresh each time: the cached info dates from when
+ * the object was created.
+ */
+NTSTATUS WINAPI PsGetProcessExitStatus( PEPROCESS process )
+{
+    PROCESS_BASIC_INFORMATION info;
+    HANDLE handle;
+    NTSTATUS status = process->info.ExitStatus;
+
+    if ((handle = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE,
+                               HandleToUlong( (HANDLE)process->info.UniqueProcessId ) )))
+    {
+        if (!NtQueryInformationProcess( handle, ProcessBasicInformation, &info, sizeof(info), NULL ))
+            status = info.ExitStatus;
+        NtClose( handle );
+    }
+    TRACE("%p -> %#lx\n", process, status);
+    return status;
+}
