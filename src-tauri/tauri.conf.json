{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLauncher",
  "version": "0.2.2",
  "identifier": "com.llauncher.linux",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build && bash scripts/prepare-appimage-files.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLauncher",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/gio/modules/libgiognutls.so": "bundle-extra/libgiognutls.so"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
