[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
Actions=play;

[Desktop Action play]
Name=Launch Arknights: Endfield
Name[ru]=Запустить Arknights: Endfield
Exec={{exec}} --play
Icon={{icon}}
