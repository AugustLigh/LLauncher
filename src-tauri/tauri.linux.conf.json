{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "yarn build && bash scripts/prepare-appimage-files.sh"
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/gio/modules/libgiognutls.so": "bundle-extra/libgiognutls.so",
          "/usr/lib/gstreamer-1.0": "bundle-extra/gstreamer-1.0"
        }
      },
      "deb": {
        "desktopTemplate": "llauncher.desktop"
      },
      "rpm": {
        "desktopTemplate": "llauncher.desktop"
      }
    }
  }
}
