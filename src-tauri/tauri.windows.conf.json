{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Spanish",
          "PortugueseBR",
          "Indonesian",
          "Thai",
          "Vietnamese"
        ]
      }
    }
  }
}